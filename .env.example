# Reference values for local development. The backend reads CLARIO_* variables from
# backend/.env (or the environment); the frontend reads VITE_* from frontend/.env.
# The backend must remain loopback-only for the local desktop application.
CLARIO_HOST=127.0.0.1
CLARIO_PORT=8766
CLARIO_LOG_LEVEL=INFO
# Set to true to expose the interactive API docs at /docs during development.
CLARIO_ENABLE_DOCS=false
VITE_API_BASE_URL=http://127.0.0.1:8766/api/v1
